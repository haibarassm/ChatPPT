# LLM配置 (使用LangChain默认环境变量)

# API密钥 - 硅基流动和OpenAI共用
OPENAI_API_KEY=your_api_key_here

# API基础URL - 可选
# 硅基流动: https://api.siliconflow.cn/v1
# OpenAI: 不需要设置（使用默认）
OPENAI_API_BASE=https://api.siliconflow.cn/v1

# Ollama本地运行（可选）
# OLLAMA_BASE_URL=http://localhost:11434

# 说明：
# 1. 使用硅基流动：设置 OPENAI_API_KEY 和 OPENAI_API_BASE
# 2. 使用OpenAI：只需设置 OPENAI_API_KEY
# 3. 使用Ollama：无需设置API密钥，确保Ollama服务运行即可

